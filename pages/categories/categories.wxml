<view class="screen cat-page">
  <view class="cat-header">
    <view class="cat-search">
      <text class="search-icon">⌕</text>
      <input class="search-input" value="{{searchQuery}}" bindinput="onSearch" placeholder="搜索分类..." />
    </view>
    <view class="cat-add-btn" catchtap="onAdd">新增</view>
  </view>

  <view class="filter-tags" style="margin-top:20rpx;">
    <text style="font-size:24rpx;color:#9b9690;margin-right:8rpx;">展开</text>
    <view class="ftag {{expandLevel === 0 ? 'on' : ''}}" catchtap="expandToLevel" data-level="0">折叠</view>
    <view class="ftag {{expandLevel === 1 ? 'on' : ''}}" catchtap="expandToLevel" data-level="1">展开</view>
  </view>

  <view class="result-bar" wx:if="{{!loading}}">
    <text class="result-count">共 {{totalCount}} 条笔记分布在 {{rows.length}} 个分类中</text>
  </view>

  <view wx:if="{{loading && !rows.length && !error}}" class="cat-state">
    <view class="spinner"></view>
    <text class="cat-state-text">加载分类数据...</text>
  </view>

  <view wx:elif="{{error}}" class="cat-state">
    <text class="cat-state-icon">⚠</text>
    <text class="cat-state-text">{{error}}</text>
    <view class="retry-btn" catchtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{!rows.length && !searchQuery}}" class="cat-state">
    <text class="cat-state-icon">📂</text>
    <text class="cat-state-text">还没有分类数据</text>
    <text class="cat-state-desc">同步微信读书后，向量分类会自动生成分类</text>
  </view>

  <view wx:elif="{{!rows.length && searchQuery}}" class="cat-state">
    <text class="cat-state-icon">🔍</text>
    <text class="cat-state-text">未找到匹配的分类</text>
  </view>

  <view wx:else class="cat-list">
    <block wx:for="{{rows}}" wx:key="path">
      <view class="cat-row depth-{{item.depth}}" catchtap="toggleExpand" data-path="{{item.path}}">
        <text class="cat-arrow {{item.hasChildren ? (item.expanded ? 'open' : '') : 'leaf'}}">
          {{item.hasChildren ? (item.expanded ? '▾' : '▸') : '·'}}
        </text>
        <view class="cat-info">
          <text class="cat-name">{{item.name}}</text>
        </view>
        <view class="cat-badge {{item.childNoteCount > 0 ? 'active' : ''}}">{{item.childNoteCount}}</view>
        <view class="cat-ops">
          <text class="cat-op" catchtap="onEdit" data-path="{{item.path}}">✎</text>
          <text class="cat-op" wx:if="{{item.depth === 0}}" catchtap="onAddChild" data-path="{{item.path}}" data-depth="{{item.depth}}">＋</text>
          <text class="cat-op danger" catchtap="onDelete" data-path="{{item.path}}">×</text>
        </view>
      </view>
    </block>
  </view>

  <view class="sheet-mask" wx:if="{{dialogVisible}}" catchtap="closeDialog"></view>
  <view class="cat-dialog" wx:if="{{dialogVisible}}" catchtap="noop">
    <view class="dialog-head">
      <text class="dialog-title">{{form.mode === 'edit' ? '编辑分类' : '新增分类'}}</text>
      <text class="dialog-close" catchtap="closeDialog">×</text>
    </view>

    <view class="dialog-field">
      <text class="dialog-label">父级分类</text>
      <view class="dialog-readonly">{{form.parentPath || '（一级分类）'}}</view>
    </view>

    <view class="dialog-field">
      <text class="dialog-label">分类名称</text>
      <input class="dialog-input" value="{{form.name}}" bindinput="onFormName" placeholder="输入分类名称" focus="{{dialogVisible}}" />
    </view>

    <view class="dialog-field">
      <text class="dialog-label">说明（可选）</text>
      <textarea class="dialog-textarea" value="{{form.description}}" bindinput="onFormDesc" placeholder="用于向量分类时匹配语义" />
    </view>

    <view class="dialog-preview" wx:if="{{form.name}}">
      完整路径：{{form.parentPath ? form.parentPath + '/' + form.name : form.name}}
    </view>

    <view class="dialog-actions">
      <view class="dialog-btn cancel" catchtap="closeDialog">取消</view>
      <view class="dialog-btn confirm {{form.name ? '' : 'disabled'}}" catchtap="onSave">保存</view>
    </view>
  </view>
</view>
