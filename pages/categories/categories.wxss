.cat-page {
  padding-bottom: 160rpx;
}

/* ---- header ---- */
.cat-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cat-search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f0eb;
  gap: 12rpx;
}

.search-icon {
  flex-shrink: 0;
  color: #9b9690;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #050505;
}

.cat-add-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #050505;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- filter tags (reuse notes style) ---- */
.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.ftag {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5a5047;
  font-size: 24rpx;
  font-weight: 600;
}

.ftag.on {
  background: #050505;
  color: #fff;
}

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
}

.result-count {
  font-size: 22rpx;
  color: #9b9690;
}

/* ---- list ---- */
.cat-list {
  margin-top: 20rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee7dd;
}

.cat-row.depth-0 { padding-left: 0; }
.cat-row.depth-1 { padding-left: 24rpx; }
.cat-row.depth-2 { padding-left: 48rpx; }

.cat-arrow {
  width: 28rpx;
  font-size: 24rpx;
  color: #9b9690;
  text-align: center;
  flex-shrink: 0;
}

.cat-arrow.leaf { color: #d4cec5; }
.cat-arrow.open { color: #050505; }

.cat-info {
  flex: 1;
  min-width: 0;
}

.cat-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #050505;
  display: block;
}

.cat-path {
  font-size: 21rpx;
  color: #b9b0a5;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-badge {
  flex-shrink: 0;
  width: 72rpx;
  height: 36rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #f0e8dd;
  font-size: 21rpx;
  font-weight: 700;
  color: #9b9690;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-badge.active {
  background: #050505;
  color: #fff;
}

.cat-ops {
  display: flex;
  gap: 8rpx;
  width: 148rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
  justify-content: flex-end;
}

.cat-op {
  width: 42rpx;
  height: 42rpx;
  padding: 0;
  border-radius: 50%;
  background: #f8f3ec;
  border: 1rpx solid #eadfd2;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  color: #8f765b;
  font-weight: 800;
  box-sizing: border-box;
}

.cat-op.danger {
  background: #fff1f1;
  border-color: #ffd2d2;
  color: #c1121f;
}

/* ---- state ---- */
.cat-state {
  padding: 140rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cat-state-icon {
  font-size: 64rpx;
}

.cat-state-text {
  font-size: 28rpx;
  color: #5a5047;
  font-weight: 600;
}

.cat-state-desc {
  font-size: 24rpx;
  color: #9b9690;
  text-align: center;
}

.retry-btn {
  margin-top: 12rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #050505;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #e8e0d5;
  border-top-color: #050505;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.cat-refresh-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

/* ---- dialog ---- */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 50;
}

.cat-dialog {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fbf4ed;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 51;
}

.dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #050505;
}

.dialog-close {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0e8dd;
  color: #343838;
  font-size: 38rpx;
}

.dialog-field {
  margin-bottom: 20rpx;
}

.dialog-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #9b9690;
  margin-bottom: 8rpx;
  display: block;
}

.dialog-readonly {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f0e8dd;
  font-size: 26rpx;
  color: #9b9690;
}

.dialog-input {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f0e8dd;
  font-size: 26rpx;
  color: #050505;
}

.dialog-textarea {
  width: 100%;
  height: 120rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f0e8dd;
  font-size: 26rpx;
  color: #050505;
  box-sizing: border-box;
}

.dialog-preview {
  font-size: 23rpx;
  color: #8f765b;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: #faf6f0;
  border-radius: 10rpx;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.dialog-btn.cancel {
  background: #f0e8dd;
  color: #6b6560;
}

.dialog-btn.confirm {
  background: #050505;
  color: #fff;
}

.dialog-btn.disabled {
  opacity: 0.35;
}
