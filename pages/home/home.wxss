.overview-page {
  padding-bottom: 160rpx;
}

/* ---- loading gate ---- */
.loading-gate {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid #e0d8ce;
  border-top-color: #050505;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---- sync banner ---- */
.sync-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 32rpx;
  background: #050505;
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 0 0 20rpx 20rpx;
  margin: 0 0 20rpx;
}

.sync-banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4ade80;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.hero-copy {
  padding-bottom: 46rpx;
  border-bottom: 1rpx solid #e9e1d8;
}

.hero-top {
  display: flex;
  align-items: start;
}

.hero-title {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 54rpx;
  line-height: 1.22;
  color: #050505;
}

.hero-sub {
  margin-top: 28rpx;
  color: #68645f;
  font-size: 26rpx;
  line-height: 1.7;
}

.black-note {
  position: relative;
  min-height: 220rpx;
  margin-top: 64rpx;
  padding: 70rpx 42rpx 38rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #020202;
  color: #fff;
}

.black-note::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.025);
}

.quote-ghost {
  position: absolute;
  left: 42rpx;
  top: 24rpx;
  color: rgba(255,255,255,.12);
  font-size: 68rpx;
  font-family: Georgia, serif;
}

.black-note-text {
  position: relative;
  z-index: 1;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 31rpx;
  line-height: 1.65;
}

.black-note-book {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: rgba(255,255,255,.38);
  font-size: 24rpx;
}

.wide-stats {
  margin-top: 48rpx;
  padding: 34rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 28rpx;
}

.wide-stat {
  text-align: center;
  border-right: 1rpx solid #e9e1d8;
}

.wide-stat:nth-child(3n) {
  border-right: 0;
}

.wide-stat text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 500;
}

.wide-stat view {
  margin-top: 10rpx;
  color: #68645f;
  font-size: 22rpx;
}

.topic-card {
  margin-top: 48rpx;
  padding: 38rpx 36rpx;
}

.topic-label {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #050505;
  margin-bottom: 24rpx;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.topic-tag {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5a5047;
  font-size: 24rpx;
  font-weight: 600;
}

.topic-summary {
  margin-top: 24rpx;
  color: #9b9690;
  font-size: 23rpx;
}

.recent-head {
  margin: 58rpx 0 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.recent-title {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 34rpx;
  color: #050505;
}

.recent-more {
  color: #68645f;
  font-size: 22rpx;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.recent-card {
  padding: 34rpx 36rpx;
}

.recent-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.recent-book {
  min-width: 0;
  color: #050505;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex: none;
  color: #9b9690;
  font-size: 22rpx;
}

.recent-quote {
  margin-top: 28rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid #050505;
  color: #3e3c39;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 26rpx;
  line-height: 1.78;
}
