.home {
  position: relative;
  padding-bottom: 150rpx;
}

.hello {
  font-size: 32rpx;
  font-weight: 600;
  color: #3b332a;
}

.small {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.headline {
  margin-top: 44rpx;
  font-size: 60rpx;
  line-height: 1.22;
  font-weight: 600;
  color: #302820;
}

.subline {
  margin: 24rpx 0 30rpx;
  font-size: 26rpx;
  color: #8a6a4b;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.stat {
  min-height: 112rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.stat text {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  color: #3a3028;
}

.stat view {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8e8377;
}

.quote-card {
  position: relative;
  margin-top: 28rpx;
  padding: 34rpx 34rpx 30rpx;
  min-height: 188rpx;
  background:
    linear-gradient(90deg, rgba(154, 112, 62, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #fffdf8, #f8efe1);
  background-size: 34rpx 34rpx;
  color: #42362b;
}

.quote-mark {
  font-size: 58rpx;
  line-height: 40rpx;
  color: #d6b98e;
}

.quote-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.78;
  font-weight: 400;
}

.quote-source {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9b8e80;
}

.section-head {
  margin: 34rpx 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  min-height: 128rpx;
  padding: 14rpx;
  display: flex;
  gap: 18rpx;
}

.mini-cover {
  width: 76rpx;
  height: 104rpx;
  flex: none;
}

.recent-main {
  min-width: 0;
  flex: 1;
}

.recent-book {
  font-size: 24rpx;
  font-weight: 600;
  color: #4a3f34;
}

.recent-text {
  margin: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: #55483c;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tiny {
  font-size: 20rpx;
}

.floating-add {
  position: fixed;
  right: 38rpx;
  bottom: 132rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #6e8b79;
  color: #fff;
  font-size: 42rpx;
  box-shadow: 0 14rpx 30rpx rgba(65, 102, 82, 0.22);
}
