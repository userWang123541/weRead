.overview-page {
  padding-bottom: 160rpx;
}

.hero-copy {
  padding-bottom: 46rpx;
  border-bottom: 1rpx solid #e9e1d8;
}

.hero-top {
  display: flex;
  align-items: start;
}

.hero-title {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 54rpx;
  line-height: 1.22;
  color: #050505;
}

.hero-sub {
  margin-top: 28rpx;
  color: #68645f;
  font-size: 26rpx;
  line-height: 1.7;
}

.black-note {
  position: relative;
  min-height: 220rpx;
  margin-top: 64rpx;
  padding: 70rpx 42rpx 38rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #020202;
  color: #fff;
}

.black-note::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.025);
}

.quote-ghost {
  position: absolute;
  left: 42rpx;
  top: 24rpx;
  color: rgba(255,255,255,.12);
  font-size: 68rpx;
  font-family: Georgia, serif;
}

.black-note-text {
  position: relative;
  z-index: 1;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 31rpx;
  line-height: 1.65;
}

.black-note-book {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: rgba(255,255,255,.38);
  font-size: 24rpx;
}

.wide-stats {
  margin-top: 48rpx;
  padding: 34rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 28rpx;
}

.wide-stat {
  text-align: center;
  border-right: 1rpx solid #e9e1d8;
}

.wide-stat:nth-child(3n) {
  border-right: 0;
}

.wide-stat text,
.feature-num {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 500;
}

.wide-stat view {
  margin-top: 10rpx;
  color: #68645f;
  font-size: 22rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24rpx;
  margin-top: 32rpx;
}

.feature-card {
  min-height: 220rpx;
  padding: 34rpx 32rpx;
}

.feature-title {
  margin-top: 24rpx;
  font-size: 27rpx;
  color: #171717;
}

.feature-desc {
  margin-top: 16rpx;
  color: #73706b;
  font-size: 22rpx;
  line-height: 1.55;
}

.recent-head {
  margin: 58rpx 0 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.recent-title {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 34rpx;
  color: #050505;
}

.recent-more {
  color: #68645f;
  font-size: 22rpx;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.recent-card {
  padding: 34rpx 36rpx;
}

.recent-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.recent-book {
  min-width: 0;
  color: #050505;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex: none;
  color: #9b9690;
  font-size: 22rpx;
}

.recent-quote {
  margin-top: 28rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid #050505;
  color: #3e3c39;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 26rpx;
  line-height: 1.78;
}
