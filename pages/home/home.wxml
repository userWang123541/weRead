<view class="screen overview-page">
  <!-- 等待鉴权 -->
  <view wx:if="{{!ready}}" class="loading-gate">
    <view class="loading-spinner"></view>
  </view>

  <!-- 主内容 -->
  <block wx:if="{{ready}}">

  <view class="hero-copy">
    <view class="hero-top">
      <view class="hero-title">阅读不是记录，<br />是再组织</view>
    </view>
    <view class="hero-sub">把微信读书的划线、想法、书评，变成可检索、可判断、可创作的生产力素材。</view>
  </view>

  <view class="black-note">
    <view class="quote-ghost">“</view>
    <view class="black-note-text">{{quote.text || '阅读好书，就像是和过去最伟大的智者交谈。'}}</view>
    <view class="black-note-book">— {{quote.book || quote.bookTitle || '未知书籍'}}</view>
  </view>

  <view class="wide-stats card">
    <view class="wide-stat"><text>{{stats.books || 0}}</text><view>书籍</view></view>
    <view class="wide-stat"><text>{{stats.highlights || 0}}</text><view>划线</view></view>
    <view class="wide-stat"><text>{{stats.notes || 0}}</text><view>想法</view></view>
    <view class="wide-stat"><text>{{stats.unclassified || 0}}</text><view>未分类</view></view>
    <view class="wide-stat"><text>{{stats.classified || 0}}</text><view>已分类</view></view>
    <view class="wide-stat"><text>{{stats.readingDays || 0}}</text><view>阅读日</view></view>
  </view>

  <!-- 今日主题 -->
  <view class="topic-card card">
    <view class="topic-label">今日主题</view>
    <view class="topic-tags">
      <block wx:for="{{topCategories}}" wx:key="*this">
        <view class="topic-tag">{{item}}</view>
      </block>
      <view wx:if="{{!topCategories.length}}" class="topic-tag">等待分类数据</view>
    </view>
    <view class="topic-summary">{{topicCount}} 个知识主题 · {{classifiedCount}} 条已归类笔记</view>
  </view>

  <view class="recent-head">
    <view class="recent-title">最近素材</view>
    <view class="recent-more" bindtap="goNotes">查看全部 →</view>
  </view>
  <view class="recent-list">
    <block wx:for="{{recentCards}}" wx:key="id">
      <view class="recent-card card" data-bookid="{{item.bookId}}" bindtap="goNotes">
        <view class="recent-meta">
          <view class="recent-book">{{item.bookTitle}}</view>
          <view class="recent-time">{{item.timeAgo}}</view>
        </view>
        <view class="recent-quote">{{item.quote}}</view>
      </view>
    </block>
  </view>
  </block>
</view>
