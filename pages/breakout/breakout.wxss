.rank-list {
  padding: 8rpx 20rpx;
  margin-top: 18rpx;
}

.rank-item {
  min-height: 132rpx;
  display: grid;
  grid-template-columns: 58rpx 72rpx 1fr auto;
  gap: 18rpx;
  align-items: center;
  border-bottom: 1rpx solid #eee1d1;
}

.rank-item:last-child {
  border-bottom: 0;
}

.rank {
  font-size: 34rpx;
  font-weight: 900;
}

.tiny-cover {
  width: 72rpx;
  height: 96rpx;
}

.rank-title {
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f2e0c8;
  color: #8c6437;
  font-size: 20rpx;
}

.generate {
  margin-top: 28rpx;
}
