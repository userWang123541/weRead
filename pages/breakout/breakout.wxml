<view class="screen">
  <view class="nav">
    <button class="icon-button" bindtap="back">‹</button>
    <view class="nav-title">破圈书单推荐</view>
    <button class="icon-button">分享</button>
  </view>
  <view class="pill-row">
    <block wx:for="{{tabs}}" wx:key="*this">
      <view class="pill {{index === 0 ? 'active' : ''}}">{{item}}</view>
    </block>
  </view>
  <view class="rank-list card">
    <block wx:for="{{books}}" wx:key="rank">
      <view class="rank-item">
        <view class="rank">{{item.rank}}</view>
        <view class="tiny-cover cover {{item.palette}}">
          <text class="cover-title">{{item.title}}</text>
        </view>
        <view class="rank-main">
          <view class="rank-title">{{item.title}}</view>
          <view class="muted">{{item.author}}</view>
        </view>
        <view class="tag">{{item.tag}}</view>
      </view>
    </block>
  </view>
  <button class="generate secondary-button">生成我的完整报告海报</button>
</view>
