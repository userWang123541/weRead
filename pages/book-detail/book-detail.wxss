.detail {
  padding-bottom: 60rpx;
}

.hero {
  position: relative;
  text-align: center;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #eee9df;
}

.detail-cover {
  width: 180rpx;
  height: 240rpx;
  margin: -20rpx auto 28rpx;
}

.book-name {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #2f2922;
}

.ring {
  position: absolute;
  right: 4rpx;
  top: 214rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 8rpx solid #3a332b;
  border-left-color: #eee8dc;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 253, 248, 0.88);
}

.ring-score {
  font-size: 26rpx;
  font-weight: 500;
}

.read-stats {
  margin-top: 28rpx;
  padding: 26rpx 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  text-align: center;
}

.read-stats view:first-child {
  border-right: 1rpx solid #eadccc;
}

.read-stats text {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.read-stats label {
  margin-top: 8rpx;
  display: block;
  color: #94877a;
  font-size: 22rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin: 24rpx 0 32rpx;
}

.block-title {
  margin: 28rpx 0 16rpx;
}

.timeline {
  padding: 22rpx 26rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 18rpx 92rpx 1fr;
  gap: 14rpx;
  align-items: center;
  min-height: 58rpx;
  font-size: 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8a7a5a;
}

.date {
  color: #806f60;
}

.tag {
  grid-column: 3;
  width: fit-content;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #8a7a5a;
  font-size: 20rpx;
}

.ai-box {
  padding: 28rpx;
  color: #5f554b;
  font-size: 25rpx;
  line-height: 1.72;
}
