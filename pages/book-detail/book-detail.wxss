.detail-page {
  padding-top: 24rpx;
  padding-bottom: 120rpx;
}

.detail-hero {
  text-align: center;
}

.detail-cover {
  width: 220rpx;
  height: 310rpx;
  margin: 0 auto 32rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ede8df;
  box-shadow: 0 14rpx 34rpx rgba(36, 24, 12, 0.08);
}

.cover-img {
  width: 100%;
  height: 100%;
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  will-change: transform;
}

.detail-cover.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  font-size: 30rpx;
}

.book-name {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.detail-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 46rpx;
}

.detail-stats .profile-stat {
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.detail-stats .profile-stat text {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 800;
}

.detail-stats .profile-stat label {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #343838;
}

.detail-actions {
  margin-top: 34rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 48rpx;
}

.section-more {
  color: #68645f;
  font-size: 22rpx;
}

.timeline {
  padding: 20rpx 32rpx;
}

.timeline-header {
  display: grid;
  grid-template-columns: 160rpx 1fr;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #d1cdc5;
  font-size: 22rpx;
  font-weight: 700;
  color: #68645f;
}

.timeline-item {
  min-height: 72rpx;
  display: grid;
  grid-template-columns: 160rpx 1fr;
  gap: 16rpx;
  align-items: center;
  border-bottom: 1rpx solid #e5ddd4;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.timeline-item:last-child {
  border-bottom: 0;
}

.timeline-date {
  color: #68645f;
  font-size: 24rpx;
  white-space: nowrap;
}

.timeline-action {
  color: #343838;
  line-height: 1.5;
}

.note-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.note-quote {
  padding-left: 24rpx;
  border-left: 5rpx solid #d1d3d0;
  font-size: 29rpx;
  line-height: 1.75;
}

.note-meta {
  margin-top: 22rpx;
  font-size: 23rpx;
}

/* ---- missing styles ---- */
.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #9b9690;
}

.action-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.highlights-list,
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}
