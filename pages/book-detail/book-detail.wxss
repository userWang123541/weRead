.detail {
  padding-bottom: 60rpx;
}

.hero {
  position: relative;
  text-align: center;
}

.detail-cover {
  width: 180rpx;
  height: 240rpx;
  margin: -20rpx auto 28rpx;
}

.book-name {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.ring {
  position: absolute;
  right: 4rpx;
  top: 214rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 10rpx solid #e87820;
  border-left-color: #ecdcc9;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 250, 242, 0.8);
}

.ring-score {
  font-size: 26rpx;
  font-weight: 800;
}

.read-stats {
  margin-top: 34rpx;
  padding: 24rpx 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  text-align: center;
}

.read-stats view:first-child {
  border-right: 1rpx solid #eadccc;
}

.read-stats text {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.read-stats label {
  margin-top: 8rpx;
  display: block;
  color: #94877a;
  font-size: 22rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin: 24rpx 0 32rpx;
}

.block-title {
  margin: 28rpx 0 16rpx;
}

.timeline {
  padding: 20rpx 24rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 18rpx 92rpx 1fr;
  gap: 14rpx;
  align-items: center;
  min-height: 58rpx;
  font-size: 24rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d69d5b;
}

.date {
  color: #806f60;
}

.tag {
  grid-column: 3;
  width: fit-content;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1dfc9;
  color: #8a5f30;
  font-size: 20rpx;
}

.ai-box {
  padding: 24rpx;
  color: #4d4135;
  font-size: 25rpx;
  line-height: 1.5;
}
