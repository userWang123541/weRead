<view class="screen detail-page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{book}}">
    <view class="category-nav">
      <button class="top-icon" bindtap="back">‹</button>
      <view class="top-title">书籍详情</view>
      <view></view>
    </view>

    <view class="detail-hero">
      <view class="detail-cover" wx:if="{{book.cover}}">
        <image class="cover-img" src="{{book.cover}}" mode="aspectFill"></image>
      </view>
      <view class="detail-cover fallback {{book.palette}}" wx:else>
        <text>{{book.title}}</text>
      </view>
      <view class="book-name">{{book.title}}</view>
      <view class="muted">{{book.author}} · {{statusText}} · 进度 {{book.progress}}%</view>
    </view>

    <view class="detail-stats">
      <view class="profile-stat card"><text>{{highlightCount}}</text><label>划线</label></view>
      <view class="profile-stat card"><text>{{reviewCount}}</text><label>想法</label></view>
    </view>

    <view class="action-grid detail-actions">
      <button class="big-button primary">继续阅读</button>
      <button class="big-button outline" bindtap="goNotes">查看笔记</button>
    </view>

    <view class="section-label" wx:if="{{timeline.length > 0}}">阅读轨迹</view>
    <view class="timeline card" wx:if="{{timeline.length > 0}}">
      <block wx:for="{{timeline}}" wx:key="date">
        <view class="timeline-item"><text>{{item.date}}</text><view>{{item.action}}</view></view>
      </block>
    </view>

    <view class="section-label" wx:if="{{highlights.length > 0}}">精选划线</view>
    <view class="highlights-list" wx:if="{{highlights.length > 0}}">
      <block wx:for="{{highlights}}" wx:key="index">
        <view class="note-card card">
          <view class="note-quote">"{{item.text}}"</view>
          <view class="muted note-meta">{{item.chapter}} {{item.timeAgo}}</view>
        </view>
      </block>
    </view>

    <view class="section-label" wx:if="{{reviews.length > 0}}">我的想法</view>
    <view class="reviews-list" wx:if="{{reviews.length > 0}}">
      <block wx:for="{{reviews}}" wx:key="index">
        <view class="note-card card">
          <view class="note-quote">{{item.text}}</view>
          <view class="muted note-meta">{{item.chapter}} {{item.timeAgo}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
