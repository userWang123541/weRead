.profile-page {
  padding-bottom: 160rpx;
}

/* ---- header ---- */
.profile-header {
  padding: 18rpx 0 10rpx;
  text-align: center;
}

.profile-header-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #050505;
}

/* ---- reader card ---- */
.reader-card {
  margin-top: 24rpx;
  padding: 44rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.reader-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: linear-gradient(135deg, #efe4d0, #c4a882);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}

.reader-name {
  font-size: 38rpx;
  font-weight: 900;
  color: #050505;
}

.reader-sub {
  margin-top: 12rpx;
  color: #9b9690;
  font-size: 26rpx;
}

/* ---- stats ---- */
.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
}

.profile-stat {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #050505;
}

.profile-stat label {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #9b9690;
}

/* ---- menu ---- */
.menu-card {
  margin-top: 28rpx;
  padding: 8rpx 36rpx 12rpx;
}

.menu-section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #b9b0a5;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  padding: 28rpx 0 12rpx;
}

.menu-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid #ece6de;
  padding: 4rpx 0;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  font-size: 32rpx;
  color: #6b6560;
  width: 40rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 29rpx;
  color: #2d2a26;
}

.menu-status {
  font-size: 22rpx;
  color: #9b9690;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #f0e8dd;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc5bb;
}

/* ---- logout ---- */
.logout-btn {
  margin: 56rpx 36rpx 0;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #c1121f;
  background: #fff;
  border: 1rpx solid #e8e0d6;
}
