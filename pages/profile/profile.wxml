<view class="profile-page">
  <view class="profile-top">
    <view class="avatar"></view>
    <view class="profile-name">Jafar</view>
    <view class="muted">阅读 {{stats.readingDays}} 天</view>
    <view class="profile-stats">
      <view><text>{{stats.books}}</text><label>本书</label></view>
      <view><text>2535</text><label>划线</label></view>
      <view><text>{{stats.notes}}</text><label>想法</label></view>
    </view>
  </view>
  <view class="member-card">
    <view>
      <view class="member-title">Pro 会员</view>
      <view>解锁年度 AI 报告和深度功能</view>
    </view>
    <button>去升级</button>
  </view>
  <view class="profile-menu card">
    <view bindtap="goSettings">我的报告 <text>›</text></view>
    <view>我的收藏 <text>›</text></view>
  </view>
</view>
