<view class="screen profile-page">
  <view class="reader-card card">
    <view class="reader-avatar">
      <text class="avatar-text">读</text>
    </view>
    <view class="reader-info">
      <view class="reader-name">{{userName}}</view>
      <view class="reader-sub">终身阅读者</view>
    </view>
  </view>

  <view class="profile-stats">
    <view class="profile-stat card">
      <text class="stat-num">{{stats.books || 0}}</text>
      <label>已读（本）</label>
    </view>
    <view class="profile-stat card">
      <text class="stat-num">{{stats.highlights || 0}}</text>
      <label>划线（条）</label>
    </view>
    <view class="profile-stat card">
      <text class="stat-num">{{stats.notes || 0}}</text>
      <label>笔记（条）</label>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-section-label">知识管理</view>
    <view class="menu-row" bindtap="goCategories">
      <text class="menu-icon">▤</text>
      <text class="menu-text">分类管理</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-section-label">数据与账号</view>
    <view class="menu-row" bindtap="goSync">
      <text class="menu-icon">↻</text>
      <text class="menu-text">同步与备份</text>
      <text class="menu-status">{{syncStatusText}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goSettings">
      <text class="menu-icon">∷</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-row" bindtap="openAbout">
      <text class="menu-icon">ⓘ</text>
      <text class="menu-text">关于微读</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
