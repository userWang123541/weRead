<view class="screen settings-page">
  <view class="category-nav">
    <button class="top-icon" bindtap="back">‹</button>
    <view class="top-title">用户设置</view>
    <view></view>
  </view>

  <view class="reader-card card">
    <view class="reader-avatar"></view>
    <view>
      <view class="reader-name small">Jafar</view>
      <view class="muted" wx:if="{{hasData}}">已阅读 {{stats.books}} 本书 · {{stats.readingDays}} 天</view>
      <view class="muted" wx:else>尚未同步数据</view>
    </view>
  </view>

  <view class="settings-section card">
    <view class="section-label inner">数据同步</view>
    <view class="settings-item" bindtap="toggleKeyInput">
      <text>WeRead API Key</text>
      <view class="key-status">
        <text class="muted">{{apiKey ? '已设置' : '未设置'}}</text>
        <text class="muted">{{showKeyInput ? '⌃' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{showKeyInput}}" class="key-input-area">
      <input class="key-input" value="{{apiKey}}" bindinput="onApiKeyInput" placeholder="输入你的 WeRead API Key" password="true" confirm-type="done" />
      <view class="key-actions">
        <button class="big-button primary key-btn" bindtap="saveAndSync" disabled="{{syncing}}">{{syncing ? '同步中...' : '保存并同步'}}</button>
        <button class="big-button outline key-btn" bindtap="clearApiKey" disabled="{{syncing}}">清除</button>
      </view>
      <view class="key-hint muted">API Key 只用于同步你的微信读书数据，请勿分享给他人。</view>
    </view>
    <view wx:if="{{hasData && !showKeyInput}}" class="settings-item" bindtap="triggerSync">
      <text>重新同步</text>
      <text class="muted">{{syncStatus === 'syncing' ? '同步中...' : syncStatus === 'classifying' ? '分类中...' : '立即开始 ›'}}</text>
    </view>
  </view>

  <view class="settings-section card">
    <view class="section-label inner">通用</view>
    <view class="settings-item" bindtap="goSyncPage"><text>同步详情</text><text class="muted">›</text></view>
    <view class="settings-item" bindtap="openNotify"><text>通知设置</text><text class="muted">›</text></view>
    <view class="settings-item" bindtap="openPrivacy"><text>隐私与安全</text><text class="muted">›</text></view>
    <view class="settings-item" bindtap="openAbout"><text>关于微读 Read</text><text class="muted">v1.0.0 ›</text></view>
  </view>
</view>
