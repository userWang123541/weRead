<view class="screen settings-page">
  <view class="settings-section card">
    <view class="section-label">数据同步</view>
    <view class="settings-item" bindtap="toggleKeyInput">
      <text>WeRead API Key</text>
      <view class="item-right">
        <text class="muted">{{apiKey ? '已设置' : '未设置'}}</text>
        <text class="muted">{{showKeyInput ? '⌃' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{showKeyInput}}" class="key-input-area">
      <input class="key-input" value="{{apiKey}}" bindinput="onApiKeyInput" placeholder="输入你的 WeRead API Key" password="true" />
      <view class="key-actions">
        <view class="key-btn primary" bindtap="saveAndSync">{{syncing ? '同步中...' : '保存并同步'}}</view>
        <view class="key-btn outline" bindtap="clearApiKey">清除</view>
      </view>
      <view class="key-hint muted">API Key 只用于同步你的微信读书数据，请勿分享给他人。</view>
    </view>
    <view wx:if="{{hasData && !showKeyInput}}" class="settings-item" bindtap="triggerSync">
      <text>重新同步</text>
      <text class="muted">{{syncStatus === 'syncing' ? '同步中...' : '立即开始 ›'}}</text>
    </view>
  </view>

  <view class="settings-section card">
    <view class="section-label">通用</view>
    <view class="settings-item" bindtap="changeQuoteInterval">
      <text>首页语录轮换间隔</text>
      <text class="muted">{{quoteIntervalLabel}} ›</text>
    </view>
    <view class="settings-item" bindtap="openPrivacy">
      <text>隐私与安全</text>
      <text class="muted">›</text>
    </view>
  </view>
</view>
