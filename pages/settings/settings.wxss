.settings-page {
  padding-bottom: 140rpx;
}

.page-title-bar {
  padding: 18rpx 36rpx 10rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #050505;
}

/* ---- sections ---- */
.settings-section {
  margin-top: 28rpx;
  padding: 4rpx 36rpx;
}

.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #b9b0a5;
  letter-spacing: 2rpx;
  padding: 28rpx 0 12rpx;
}

.settings-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid #ece6de;
  font-size: 29rpx;
  color: #2d2a26;
}

.settings-item:last-child {
  border-bottom: 0;
}

.item-right {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.muted {
  color: #9b9690;
  font-size: 26rpx;
}

/* ---- key input ---- */
.key-input-area {
  padding: 20rpx 0 30rpx;
}

.key-input {
  height: 78rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f4eee6;
  font-size: 26rpx;
}

.key-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.key-btn {
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
}

.key-btn.primary {
  background: #050505;
  color: #fff;
}

.key-btn.outline {
  background: #fff;
  border: 1rpx solid #d4cec6;
  color: #6b6560;
}

.key-hint {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
}
