.tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 24rpx;
}

.tab {
  padding-bottom: 10rpx;
  font-size: 27rpx;
  color: #827467;
}

.tab.active {
  color: #15110f;
  font-weight: 800;
  border-bottom: 5rpx solid #df741e;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.book-card {
  padding: 18rpx;
  min-height: 348rpx;
}

.book-cover {
  width: 100%;
  height: 184rpx;
  margin-bottom: 16rpx;
}

.book-title {
  font-size: 25rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-author {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8a7c70;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-line {
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #ede4d8;
  overflow: hidden;
}

.progress-line view {
  height: 100%;
  border-radius: 999rpx;
  background: #e57620;
}

.progress-text {
  margin-top: 6rpx;
  text-align: right;
  color: #8d8073;
  font-size: 20rpx;
}
