.tabs {
  display: flex;
  gap: 34rpx;
  margin: 6rpx 0 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee9df;
}

.tab {
  padding-bottom: 8rpx;
  font-size: 25rpx;
  color: #9a9288;
}

.tab.active {
  color: #25211d;
  font-weight: 500;
  border-bottom: 2rpx solid #25211d;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.book-card {
  padding: 20rpx;
  min-height: 360rpx;
  background: #fffdf8;
}

.book-cover {
  width: 100%;
  height: 192rpx;
  margin-bottom: 18rpx;
}

.book-title {
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-author {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9a9288;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-line {
  height: 4rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #eee9df;
  overflow: hidden;
}

.progress-line view {
  height: 100%;
  border-radius: 999rpx;
  background: #292520;
}

.progress-text {
  margin-top: 6rpx;
  text-align: right;
  color: #8d8073;
  font-size: 20rpx;
}
