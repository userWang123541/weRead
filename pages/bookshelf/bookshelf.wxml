<view class="screen library-page">
  <view class="library-tabs">
    <view class="library-tab {{active === 0 ? 'active' : ''}}" data-index="0" bindtap="setTab">在读 {{readingCount}}</view>
    <view class="library-tab {{active === 1 ? 'active' : ''}}" data-index="1" bindtap="setTab">已读完 {{completedCount}}</view>
    <view class="library-tab {{active === 2 ? 'active' : ''}}" data-index="2" bindtap="setTab">未读 {{unreadCount}}</view>
  </view>

  <view class="book-grid">
    <block wx:for="{{filteredBooks}}" wx:key="bookId">
      <view class="book-cell" data-id="{{item.bookId}}" bindtap="openBook">
        <view class="book-art {{item.palette || ''}}">
          <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"></image>
          <view wx:else class="book-art-title">{{item.title}}</view>
        </view>
        <view class="book-title">{{item.title}}</view>
        <view class="book-author">{{item.author}}</view>
        <view class="progress-row">
          <text>当前进度</text>
          <text>{{item.progress || item.readingProgress || 0}}%</text>
        </view>
        <view class="progress-track"><view style="width: {{item.progress || item.readingProgress || 0}}%;"></view></view>
      </view>
    </block>
  </view>
</view>
