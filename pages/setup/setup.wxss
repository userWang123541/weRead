.setup-page {
  min-height: 100vh;
  background: #fbf4ed;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}

.setup-center {
  width: 100%;
  text-align: center;
}

/* ---- onboarding intro ---- */

.intro-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.intro-hero {
  width: 100%;
  text-align: left;
  margin-bottom: 28rpx;
}

.intro-brand {
  color: #8f765b;
  font-size: 25rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.intro-headline {
  font-family: Georgia, "Songti SC", serif;
  color: #050505;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.intro-lead {
  margin-top: 22rpx;
  color: #6f6962;
  font-size: 27rpx;
  line-height: 1.65;
}

.intro-swiper {
  width: 100%;
  height: 430rpx;
}

.intro-slide {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  height: 100%;
}

.intro-icon {
  font-size: 100rpx;
  margin-bottom: 48rpx;
}

.intro-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #050505;
  margin-bottom: 24rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: #73706b;
  line-height: 1.7;
  text-align: center;
  padding: 0 20rpx;
}

.intro-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 40rpx 0;
}

.intro-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d8d0c7;
  transition: all 0.3s;
}

.intro-dot.active {
  width: 36rpx;
  border-radius: 7rpx;
  background: #8f765b;
}

.intro-actions {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.intro-skip {
  flex: 1;
  height: 96rpx;
  border-radius: 22rpx;
  background: #f0e8dd;
  color: #6b6560;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.intro-btn {
  flex: 2;
  height: 96rpx;
  border-radius: 22rpx;
  background: #050505;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- logo & icons ---- */

.setup-logo {
  font-size: 72rpx;
  color: #8f765b;
  margin-bottom: 32rpx;
}

.setup-check {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #050505;
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.setup-error-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #c1121f;
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

/* ---- text ---- */

.setup-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
  color: #050505;
  margin-bottom: 18rpx;
}

.setup-sub {
  font-size: 27rpx;
  color: #73706b;
  line-height: 1.65;
  margin-bottom: 34rpx;
}

.value-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.value-card {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fffefd;
  border: 1rpx solid #eee5db;
  text-align: left;
}

.value-mark {
  flex: none;
  color: #b9b0a5;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22rpx;
}

.value-title {
  color: #050505;
  font-size: 26rpx;
  font-weight: 800;
}

.value-desc {
  margin-top: 8rpx;
  color: #77716a;
  font-size: 23rpx;
  line-height: 1.45;
}

/* ---- form ---- */

.setup-form {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 6rpx 6rpx 6rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.setup-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #050505;
}

.setup-toggle {
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f0e8dd;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b6560;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setup-hint {
  font-size: 25rpx;
  color: #8f765b;
  margin-bottom: 48rpx;
  text-decoration: underline;
}

/* ---- button ---- */

.setup-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 22rpx;
  background: #050505;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setup-btn.disabled {
  opacity: 0.3;
}

/* ---- spinner ---- */

.setup-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e0d8ce;
  border-top-color: #050505;
  border-radius: 50%;
  margin: 0 auto 36rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---- syncing carousel ---- */

.sync-carousel {
  margin-bottom: 48rpx;
  height: 80rpx;
}

.sync-carousel-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  animation: fadeIn 0.5s ease;
}

.sync-carousel-icon {
  font-size: 36rpx;
}

.sync-carousel-text {
  font-size: 28rpx;
  color: #5a5650;
  line-height: 1.5;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- progress ---- */

.setup-progress {
  margin-top: 16rpx;
  width: 80%;
  margin-left: auto;
  margin-right: auto;
}

.progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e9e1d8;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #050505;
  transition: width 0.3s;
}

.progress-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9b9690;
  display: block;
  text-align: center;
}

/* ---- error ---- */

.setup-error {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #c1121f;
  line-height: 1.5;
}
