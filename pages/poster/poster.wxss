.poster-page {
  background: #0d0b09;
}

.poster-card {
  min-height: 760rpx;
  padding: 54rpx 42rpx;
  border-radius: 18rpx;
  color: #ffe9bb;
  background:
    radial-gradient(circle at 82% 12%, rgba(236, 161, 62, 0.32), transparent 30%),
    linear-gradient(145deg, #15110d, #2b2117 68%, #0d0b09);
  border: 1rpx solid rgba(255, 224, 168, 0.18);
}

.poster-kicker {
  font-size: 26rpx;
}

.poster-title {
  margin-top: 38rpx;
  font-size: 68rpx;
  line-height: 1.14;
  font-weight: 900;
}

.poster-tags {
  margin-top: 34rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.poster-tags text {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 224, 168, 0.14);
  font-size: 22rpx;
}

.poster-bottom {
  margin-top: 280rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: 24rpx;
}

.qr {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.poster-page .secondary-button {
  margin-top: 28rpx;
  background: #f2d6ad;
}
