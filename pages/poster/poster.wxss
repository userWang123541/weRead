.poster-page {
  background: #faf8f3;
}

.poster-card {
  min-height: 760rpx;
  padding: 54rpx 42rpx;
  border-radius: 18rpx;
  color: #2b2621;
  background:
    linear-gradient(90deg, rgba(138, 122, 90, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #fffdf8, #f3efe7);
  background-size: 36rpx 36rpx;
  border: 1rpx solid #eee6da;
}

.poster-kicker {
  font-size: 26rpx;
}

.poster-title {
  margin-top: 38rpx;
  font-size: 68rpx;
  line-height: 1.14;
  font-weight: 400;
}

.poster-tags {
  margin-top: 34rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.poster-tags text {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #6f665c;
  font-size: 22rpx;
}

.poster-bottom {
  margin-top: 280rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: 24rpx;
}

.qr {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  border: 1rpx solid #ded6ca;
}

.poster-page .secondary-button {
  margin-top: 28rpx;
  background: #fffdf8;
}
