<view class="screen notes-page">
  <view class="nav">
    <view class="nav-title">笔记</view>
    <view class="nav-actions">
      <button class="icon-button" bindtap="goSearch">⌕</button>
      <button class="icon-button">···</button>
    </view>
  </view>
  <view class="search-box">⌕ 搜索观点、情绪、概念</view>
  <view class="pill-row">
    <block wx:for="{{filters}}" wx:key="*this">
      <view class="pill {{active === index ? 'active' : ''}}" data-index="{{index}}" bindtap="setFilter">{{item}}</view>
    </block>
  </view>
  <view class="note-list">
    <block wx:for="{{notes}}" wx:key="id">
      <view class="note-card card">
        <view class="note-top">
          <view class="mini-cover cover {{item.id === 'n1' ? 'dark' : 'orange'}}">
            <text class="cover-title">{{item.book}}</text>
          </view>
          <view>
            <view class="book">{{item.book}}</view>
            <view class="muted tiny">···</view>
          </view>
        </view>
        <view class="note-title">{{item.title}}</view>
        <view class="note-body">{{item.body}}</view>
        <view class="tag-row">
          <block wx:for="{{item.tags}}" wx:key="*this">
            <text>{{item}}</text>
          </block>
        </view>
        <view class="note-actions">
          <text>♡ {{item.likes}}</text>
          <text>↗</text>
          <text>↺</text>
        </view>
      </view>
    </block>
  </view>
</view>
