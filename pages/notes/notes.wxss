.notebook-page {
  padding-bottom: 160rpx;
}

.search-pill {
  margin-bottom: 38rpx;
}

.search-pill input {
  flex: 1;
  font-size: 27rpx;
}

.search-placeholder {
  color: #777c7b;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 26rpx;
}

.filter-row .tag.active {
  background: #050505;
  color: #fff;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.note-card {
  padding: 34rpx 34rpx 32rpx;
}

.note-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.note-book {
  font-size: 25rpx;
  font-weight: 800;
  color: #343838;
}

.note-chapter {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #080808;
}

.more {
  font-size: 40rpx;
  color: #606563;
  line-height: 1;
}

.note-quote {
  margin-top: 34rpx;
  padding-left: 24rpx;
  border-left: 5rpx solid #d1d3d0;
  font-size: 30rpx;
  line-height: 1.8;
  color: #050505;
}

.note-note {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #f4eee6;
  color: #5b5752;
  font-size: 25rpx;
  line-height: 1.55;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}
