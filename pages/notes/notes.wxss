.notebook-page {
  padding-bottom: 160rpx;
}

.search-pill {
  margin-bottom: 38rpx;
}

.search-pill input {
  flex: 1;
  font-size: 27rpx;
}

.search-placeholder {
  color: #777c7b;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 26rpx;
}

.filter-row .tag.active {
  background: #050505;
  color: #fff;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.note-card {
  padding: 34rpx 34rpx 32rpx;
}

.note-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.note-title-wrap {
  min-width: 0;
}

.note-book {
  font-size: 25rpx;
  font-weight: 800;
  color: #343838;
}

.note-chapter {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #080808;
}

.note-type {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5b5752;
  font-size: 22rpx;
  line-height: 1.2;
}

.note-quote {
  margin-top: 34rpx;
  padding-left: 24rpx;
  border-left: 5rpx solid #d1d3d0;
  font-size: 30rpx;
  line-height: 1.8;
  color: #050505;
}

.note-note {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #f4eee6;
  color: #5b5752;
  font-size: 25rpx;
  line-height: 1.55;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.category-tag {
  background: #050505;
  color: #fff;
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eee7dd;
}

.note-action {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f4eee6;
  color: #343838;
  font-size: 24rpx;
}

.note-action::after {
  border: 0;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .28);
}

.category-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 34rpx 30rpx calc(120rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fbf4ed;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #050505;
}

.sheet-sub {
  margin-top: 8rpx;
  color: #777c7b;
  font-size: 24rpx;
}

.sheet-close {
  width: 54rpx;
  height: 54rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0e8dd;
  color: #343838;
  font-size: 42rpx;
}

.category-options {
  max-height: 58vh;
}

.category-option {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #eee7dd;
  color: #343838;
  font-size: 27rpx;
  line-height: 1.35;
}

.category-option.active {
  color: #050505;
  font-weight: 800;
}
