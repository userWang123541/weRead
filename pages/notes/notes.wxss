.notebook-page {
  padding-bottom: 160rpx;
}

/* ---- search ---- */
.search-pill {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: #f4f0eb;
}

.search-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #9b9690;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #050505;
}

.search-placeholder {
  color: #b0a89e;
}

.search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #ddd6cc;
  color: #6b6560;
  font-size: 24rpx;
}

/* ---- filter bar ---- */
.filter-bar {
  margin-bottom: 16rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.ftag {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5a5047;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.ftag.on {
  background: #050505;
  color: #fff;
}

.ftag.sep {
  background: none;
  color: #d4cec5;
  padding: 0 4rpx;
  font-weight: 400;
}

/* ---- dropdowns ---- */
.dropdown-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 29;
  background: rgba(0, 0, 0, 0.15);
}

.dropdown-box {
  position: relative;
  z-index: 30;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.dropdown-scroll {
  max-height: 480rpx;
}

.dd-item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #343838;
  border-bottom: 1rpx solid #f0e8dd;
}

.dd-item:last-child {
  border-bottom: 0;
}

.dd-item.on {
  background: #f4eee6;
  color: #050505;
  font-weight: 700;
}

/* ---- category dropdown ---- */
.cat-dropdown {
  padding: 0;
}

.cat-dd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #eee7dd;
}

.cat-dd-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #050505;
}

.cat-dd-clear {
  font-size: 24rpx;
  color: #8f765b;
  font-weight: 600;
}

.cat-dd-cols {
  display: flex;
  gap: 8rpx;
  padding: 12rpx;
  height: 420rpx;
}

.cat-dd-col {
  flex: 1;
  background: #f8f3ec;
  border-radius: 12rpx;
  overflow: hidden;
}

.cat-dd-item {
  padding: 18rpx 16rpx;
  font-size: 23rpx;
  color: #5b5752;
  font-weight: 600;
  border-bottom: 1rpx solid #eee7dd;
}

.cat-dd-item:last-child {
  border-bottom: 0;
}

.cat-dd-item.on {
  background: #050505;
  color: #fff;
}

/* ---- result bar ---- */
.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-count {
  font-size: 22rpx;
  color: #9b9690;
}

.result-clear {
  font-size: 22rpx;
  color: #8f765b;
  font-weight: 600;
}

/* ---- note list ---- */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.note-card {
  padding: 30rpx;
}

.note-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.note-title-wrap {
  min-width: 0;
  flex: 1;
}

.note-book {
  font-size: 26rpx;
  font-weight: 700;
  color: #050505;
}

.note-chapter {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9b9690;
}

.note-type {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5b5752;
  font-size: 22rpx;
  font-weight: 600;
}

.note-type.type-review {
  background: #ede4f5;
  color: #7c3aed;
}

.note-quote {
  margin-top: 24rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #d1d3d0;
  font-size: 28rpx;
  line-height: 1.75;
  color: #050505;
}

.note-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f4ef;
  color: #5b5752;
  font-size: 24rpx;
  line-height: 1.55;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5b5752;
  font-size: 20rpx;
  font-weight: 600;
}

.category-tag {
  background: #050505;
  color: #fff;
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee7dd;
}

.note-action {
  margin: 0;
  padding: 0 24rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #343838;
  font-size: 23rpx;
  font-weight: 600;
}

.note-action::after {
  border: 0;
}

.page-loading {
  margin: -4rpx 0 16rpx;
  color: #8f765b;
  font-size: 23rpx;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 30rpx 0 8rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #f7f0e7;
}

.page-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #fffaf4;
  color: #5a5047;
  font-size: 24rpx;
  font-weight: 700;
}

.page-btn.primary {
  background: #050505;
  color: #fff;
}

.page-btn.disabled {
  opacity: .42;
}

.page-btn::after {
  border: 0;
}

.page-indicator {
  width: 128rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #ebe2d7;
  color: #050505;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.page-main {
  font-size: 30rpx;
  font-weight: 800;
}

.page-sub {
  margin-left: 4rpx;
  font-size: 21rpx;
  color: #8a8178;
  font-weight: 700;
}

/* ---- empty / loading ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #343838;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #9b9690;
  text-align: center;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #e8e0d5;
  border-top-color: #050505;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.muted {
  color: #9b9690;
  font-size: 24rpx;
}

/* ---- category sheet ---- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.3);
}

.category-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 32rpx 28rpx calc(100rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fbf4ed;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #050505;
}

.sheet-sub {
  margin-top: 6rpx;
  color: #9b9690;
  font-size: 23rpx;
}

.sheet-close {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0e8dd;
  color: #343838;
  font-size: 38rpx;
}

.cat-cascader {
  margin-bottom: 20rpx;
}

.cat-picker {
  width: 100%;
  height: 380rpx;
}

.cat-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #343838;
}

.sheet-footer {
  margin-top: 12rpx;
}
