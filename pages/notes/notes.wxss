.notes-page .search-box {
  margin-bottom: 18rpx;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 10rpx;
}

.note-card {
  padding: 24rpx;
}

.note-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-cover {
  width: 44rpx;
  height: 58rpx;
  display: inline-block;
  vertical-align: middle;
  margin-right: 12rpx;
}

.book {
  display: inline-block;
  vertical-align: middle;
  max-width: 520rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5f5143;
}

.note-title {
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.52;
  font-weight: 800;
  color: #201913;
}

.note-body {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.58;
  color: #706255;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag-row text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1e2d1;
  color: #8a6b49;
  font-size: 20rpx;
}

.note-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 34rpx;
  color: #8e8074;
  font-size: 22rpx;
}

.tiny {
  font-size: 22rpx;
}
