<view class="screen light-page">
  <view class="light-header">
    <view class="page-title center">拾光</view>
    <view class="light-sub">描述你想找的内容，AI 从你的阅读笔记中召回相关素材并回答。</view>
  </view>

  <view class="spark-card">
    <view class="spark">✦</view>
  </view>
  <view class="try-text">试试问我...</view>

  <view class="question-list">
    <block wx:for="{{questions}}" wx:key="*this">
      <view class="question card" data-question="{{item}}" bindtap="ask">
        <text>{{item}}</text>
      </view>
    </block>
  </view>
</view>
