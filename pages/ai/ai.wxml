<view class="screen ai-page">
  <view class="nav">
    <view class="nav-title">抬光 · AI 助手</view>
    <button class="icon-button">?</button>
  </view>
  <view class="ai-intro card">
    <view class="ai-title">从笔记里找回你的问题</view>
    <view class="muted">基于你的书架、划线和想法，重新组织那些分散的阅读线索。</view>
  </view>
  <view class="ask-box card">
    <input placeholder="问问你的阅读宇宙..." placeholder-class="placeholder" />
    <text>⌕</text>
  </view>
  <view class="section-title ask-title">推荐问题</view>
  <view class="question-list">
    <block wx:for="{{questions}}" wx:key="*this">
      <view class="question card" data-question="{{item}}" bindtap="ask">
        <text>{{item}}</text>
        <text>›</text>
      </view>
    </block>
  </view>
</view>
