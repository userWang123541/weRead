.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  width: 100%;
  background: #fbf4ed;
  overflow-x: hidden;
  max-width: 100vw;
  box-sizing: border-box;
}

/* ---- messages ---- */
.chat-messages {
  flex: 1;
  padding: 30rpx 28rpx 132rpx;
  min-height: 0;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* welcome */
.chat-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 88rpx 20rpx 60rpx;
  text-align: center;
  min-height: 0;
  box-sizing: border-box;
}

.welcome-icon {
  font-size: 56rpx;
  color: #8f765b;
  margin-bottom: 20rpx;
}

.welcome-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #050505;
  margin-bottom: 16rpx;
}

.welcome-sub {
  font-size: 26rpx;
  color: #73706b;
  line-height: 1.6;
  margin-bottom: 56rpx;
}

.welcome-questions {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.welcome-q {
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 27rpx;
  color: #343838;
  text-align: left;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* message rows */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
}

.msg-row.user {
  justify-content: flex-end;
  padding-left: 72rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.msg-row.assistant {
  justify-content: flex-start;
  align-items: flex-start;
  gap: 16rpx;
  padding-right: 0;
  max-width: 100%;
  box-sizing: border-box;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #efe4d0, #d4c5b0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8f765b;
  flex: none;
  margin-top: 4rpx;
}

.msg-content {
  max-width: 100%;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
  box-sizing: border-box;
}

.msg-bubble {
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  overflow-wrap: break-word;
  max-width: 100%;
  box-sizing: border-box;
}

.user-bubble {
  background: #050505;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.ai-bubble {
  background: #fff;
  color: #2d2a26;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  word-break: break-all;
  box-sizing: border-box;
}

/* typing animation */
.typing-dots {
  display: flex;
  gap: 10rpx;
  padding: 28rpx 36rpx;
  background: #fff;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9b0a5;
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* sources */
.msg-sources {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f4ef;
  border-radius: 16rpx;
}

.source-label {
  font-size: 22rpx;
  color: #9b9690;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.source-item {
  margin-bottom: 8rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #e9e1d8;
}

.source-item:last-child {
  border-bottom: 0;
  margin-bottom: 0;
}

.source-book {
  font-size: 22rpx;
  color: #8f765b;
  font-weight: 700;
  display: block;
  margin-bottom: 4rpx;
}

.source-quote {
  font-size: 22rpx;
  color: #6b6560;
  line-height: 1.5;
  display: block;
}

/* ---- input bar ---- */
.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 36rpx 24rpx;
  background: rgba(251, 244, 237, 0.96);
  border-top: 1rpx solid rgba(221, 211, 199, 0.72);
  box-shadow: 0 -14rpx 34rpx rgba(48, 34, 20, 0.08);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: visible;
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #f1ebe3;
  border: 1rpx solid #e5dbcf;
  font-size: 27rpx;
  color: #050505;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d8cec1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(68, 52, 35, 0.12);
}

.send-btn.active {
  background: #050505;
}

/* ---- message actions ---- */
.msg-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.msg-copy {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f0e8dd;
  color: #5b5752;
  font-size: 22rpx;
}
