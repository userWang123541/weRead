.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fbf4ed;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* ---- messages ---- */
.chat-messages {
  flex: 1;
  padding: 30rpx 28rpx;
  overflow-y: auto;
  min-height: 0;
}

/* welcome */
.chat-welcome {
  padding-top: 120rpx;
  text-align: center;
}

.welcome-icon {
  font-size: 56rpx;
  color: #8f765b;
  margin-bottom: 20rpx;
}

.welcome-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #050505;
  margin-bottom: 16rpx;
}

.welcome-sub {
  font-size: 26rpx;
  color: #73706b;
  line-height: 1.6;
  margin-bottom: 56rpx;
}

.welcome-questions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 16rpx;
}

.welcome-q {
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 27rpx;
  color: #343838;
  text-align: left;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* message rows */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.assistant {
  justify-content: flex-start;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #efe4d0, #d4c5b0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8f765b;
  flex: none;
  margin-top: 4rpx;
}

.msg-content {
  max-width: 80%;
  min-width: 0;
  overflow: hidden;
  word-break: break-all;
}

.msg-bubble {
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  overflow-wrap: break-word;
}

.user-bubble {
  background: #050505;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.ai-bubble {
  background: #fff;
  color: #2d2a26;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: block;
  max-width: 100%;
  overflow: hidden;
  word-break: break-all;
}

/* typing animation */
.typing-dots {
  display: flex;
  gap: 10rpx;
  padding: 28rpx 36rpx;
  background: #fff;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9b0a5;
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* sources */
.msg-sources {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f4ef;
  border-radius: 16rpx;
}

.source-label {
  font-size: 22rpx;
  color: #9b9690;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.source-item {
  margin-bottom: 8rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #e9e1d8;
}

.source-item:last-child {
  border-bottom: 0;
  margin-bottom: 0;
}

.source-book {
  font-size: 22rpx;
  color: #8f765b;
  font-weight: 700;
  display: block;
  margin-bottom: 4rpx;
}

.source-quote {
  font-size: 22rpx;
  color: #6b6560;
  line-height: 1.5;
  display: block;
}

/* ---- input bar ---- */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e9e1d8;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f4eee6;
  font-size: 28rpx;
  color: #050505;
}

.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e0d8ce;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #fff;
  transition: background 0.2s;
}

.send-btn.active {
  background: #050505;
}
