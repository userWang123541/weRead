.ai-page {
  text-align: center;
}

.ai-intro {
  padding: 34rpx 32rpx;
  text-align: left;
  background:
    linear-gradient(90deg, rgba(138, 122, 90, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #fffdf8, #f1eadf);
  background-size: 32rpx 32rpx;
}

.ai-title {
  margin-bottom: 14rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #2f2922;
  line-height: 1.35;
}

.ask-box {
  height: 72rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ask-box input {
  flex: 1;
  text-align: left;
  font-size: 25rpx;
}

.placeholder {
  color: #a79a8d;
}

.ask-title {
  margin: 34rpx 0 16rpx;
  text-align: left;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.question {
  min-height: 76rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: #4b4239;
}
