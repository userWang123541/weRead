.light-page {
  padding-bottom: 160rpx;
}

.light-header {
  padding-top: 18rpx;
  text-align: center;
}

.center {
  text-align: center;
  margin-bottom: 24rpx;
}

.light-sub {
  max-width: 610rpx;
  margin: 0 auto;
  color: #5c5b57;
  font-size: 30rpx;
  line-height: 1.55;
}

.spark-card {
  margin: 250rpx auto 28rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #fffefd;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 38rpx rgba(36, 24, 12, 0.06);
}

.spark {
  color: #5d5f5d;
  font-size: 48rpx;
}

.try-text {
  text-align: center;
  color: #66635f;
  font-size: 30rpx;
  margin-bottom: 58rpx;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.question {
  min-height: 102rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  color: #050505;
  font-size: 29rpx;
  line-height: 1.4;
}
