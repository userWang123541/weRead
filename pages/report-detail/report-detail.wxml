<view class="screen">
  <view class="nav">
    <button class="icon-button" bindtap="back">‹</button>
    <view class="nav-title">阅读数据总览</view>
    <button class="icon-button">分享</button>
  </view>
  <view class="pill-row">
    <view class="pill active">年度</view>
    <view class="pill active">2024</view>
    <view class="pill">全部</view>
  </view>
  <view class="data-grid">
    <view class="data-card card"><text>{{stats.books}}</text><label>读完书籍</label></view>
    <view class="data-card card"><text>2,635</text><label>划线</label></view>
    <view class="data-card card"><text>{{stats.notes}}</text><label>想法</label></view>
    <view class="data-card card"><text>{{stats.readingDays}}</text><label>阅读天数</label></view>
    <view class="data-card card"><text>{{stats.readingHours}}h</text><label>阅读时长</label></view>
    <view class="data-card card"><text>{{stats.dailyTime}}</text><label>日均阅读时长</label></view>
  </view>
  <view class="chart card">
    <view class="section-title">历年阅读趋势</view>
    <view class="bars">
      <view style="height: 38%;"></view>
      <view style="height: 54%;"></view>
      <view style="height: 72%;"></view>
      <view style="height: 66%;"></view>
      <view style="height: 88%;"></view>
      <view style="height: 80%;"></view>
    </view>
    <view class="chart-years"><text>2021</text><text>2022</text><text>2023</text><text>2024</text></view>
  </view>
  <view class="score-card card">
    <view class="gauge">{{stats.score}}<text>/100</text></view>
    <view class="score-title">中等偏窄</view>
    <view class="metric"><text>类型集中度</text><view><text style="width:72%;"></text></view><label>72%</label></view>
    <view class="metric"><text>观点多样性</text><view><text style="width:54%;"></text></view><label>54%</label></view>
    <view class="metric"><text>作者多样性</text><view><text style="width:61%;"></text></view><label>61%</label></view>
  </view>
</view>
