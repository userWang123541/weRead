.data-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 16rpx;
  overflow: hidden;
}

.data-card {
  padding: 26rpx 8rpx;
  text-align: center;
  border-radius: 0;
  box-shadow: none;
  border-right: 1rpx solid #eee9df;
  border-bottom: 1rpx solid #eee9df;
}

.data-card text {
  display: block;
  font-size: 32rpx;
  font-weight: 400;
}

.data-card label {
  margin-top: 8rpx;
  display: block;
  color: #8d8075;
  font-size: 20rpx;
}

.chart,
.score-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.bars {
  height: 210rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  border-bottom: 1rpx solid #e7d7c5;
}

.bars view {
  width: 28rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #2b2621;
  opacity: .58;
}

.chart-years {
  display: flex;
  justify-content: space-between;
  color: #938579;
  font-size: 20rpx;
  margin-top: 12rpx;
}

.gauge {
  width: 220rpx;
  height: 140rpx;
  margin: 0 auto;
  border-radius: 220rpx 220rpx 0 0;
  border: 14rpx solid #2b2621;
  border-bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  font-size: 62rpx;
  font-weight: 400;
}

.gauge text {
  font-size: 24rpx;
  color: #7e7165;
}

.score-title {
  text-align: center;
  margin: 18rpx 0 28rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.metric {
  display: grid;
  grid-template-columns: 160rpx 1fr 60rpx;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  font-size: 22rpx;
}

.metric view {
  height: 8rpx;
  border-radius: 999rpx;
  background: #eee1d4;
}

.metric view text {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: #2b2621;
  opacity: .58;
}
