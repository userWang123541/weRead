<view class="screen sync-page">
  <view class="category-nav">
    <button class="top-icon" bindtap="back">‹</button>
    <view class="top-title">同步数据</view>
    <view></view>
  </view>

  <view class="sync-card card">
    <view wx:if="{{syncStatus === 'idle'}}" class="sync-icon">✓</view>
    <view wx:elif="{{syncStatus === 'syncing'}}" class="sync-icon">↻</view>
    <view wx:elif="{{syncStatus === 'classifying'}}" class="sync-icon">↻</view>
    <view wx:else class="sync-icon error">×</view>

    <view wx:if="{{syncStatus === 'idle'}}" class="sync-title">数据已同步</view>
    <view wx:elif="{{syncStatus === 'syncing'}}" class="sync-title">正在同步...</view>
    <view wx:elif="{{syncStatus === 'classifying'}}" class="sync-title">正在分类...</view>
    <view wx:else class="sync-title">同步失败</view>

    <view class="muted sync-desc">上次同步时间：{{syncTime}}</view>
    <view wx:if="{{errorMsg}}" class="sync-desc error-text">{{errorMsg}}</view>

    <view class="sync-list">
      <view class="sync-row"><text>书架数据</text><text class="sync-ok">{{books}} 本</text></view>
      <view class="sync-row"><text>划线数据</text><text class="sync-ok">{{highlights}} 条</text></view>
      <view class="sync-row"><text>想法数据</text><text class="sync-ok">{{notes}} 条</text></view>
      <view class="sync-row"><text>卡片素材</text><text class="sync-ok">{{cards}} 张</text></view>
      <view class="sync-row"><text>已分类笔记</text><text class="sync-ok">{{classified}} 条</text></view>
    </view>

    <button class="big-button primary sync-btn" bindtap="doSync" disabled="{{syncStatus === 'syncing' || syncStatus === 'classifying'}}">
      {{syncStatus === 'syncing' || syncStatus === 'classifying' ? '同步中...' : '重新同步'}}
    </button>
  </view>
</view>
