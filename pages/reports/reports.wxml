<view class="screen reports-page">
  <view class="report-hero">
    <view class="share">分享</view>
    <view class="hero-title">你的<br />阅读人格<br />已生成</view>
    <view class="hero-sub">2024 · 微信读书年度报告</view>
    <view class="avatar hero-avatar"></view>
    <view class="name">Jafar</view>
  </view>
  <view class="persona-card" bindtap="makePoster">
    <view class="persona-label">阅读人格</view>
    <view class="persona-title">系统建筑师<br />INTJ</view>
    <view class="persona-tags">
      <text>理性</text><text>系统</text><text>深度</text><text>长期主义</text>
    </view>
  </view>
  <view class="report-list">
    <block wx:for="{{reports}}" wx:key="id">
      <view class="report-item card" data-id="{{item.id}}" bindtap="openReport">
        <view>
          <view class="report-title">{{item.title}}</view>
          <view class="muted">{{item.subtitle}}</view>
        </view>
        <view class="report-score">{{item.score}}</view>
      </view>
    </block>
  </view>
</view>
