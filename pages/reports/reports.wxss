.reports-page {
  background: #0d0b09;
  color: #fff8ec;
  padding-bottom: 120rpx;
}

.report-hero {
  position: relative;
  min-height: 550rpx;
  padding-top: 52rpx;
  background:
    radial-gradient(circle at 70% 32%, rgba(235, 167, 67, 0.34), transparent 28%),
    radial-gradient(circle at 20% 12%, rgba(255, 255, 255, 0.15), transparent 20%);
}

.share {
  position: absolute;
  right: 8rpx;
  top: 20rpx;
  font-size: 24rpx;
}

.hero-title {
  font-size: 62rpx;
  line-height: 1.12;
  font-weight: 900;
  text-align: center;
  color: #ffe9bd;
}

.hero-sub {
  margin-top: 22rpx;
  text-align: center;
  color: #d9c09c;
  font-size: 24rpx;
}

.hero-avatar {
  margin: 30rpx auto 8rpx;
}

.name {
  text-align: center;
  font-size: 24rpx;
}

.persona-card {
  min-height: 290rpx;
  margin: -50rpx 4rpx 24rpx;
  padding: 32rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, rgba(65, 44, 23, 0.96), rgba(13, 11, 9, 0.96));
  border: 1rpx solid rgba(255, 222, 162, 0.2);
  box-shadow: 0 24rpx 68rpx rgba(0, 0, 0, 0.3);
}

.persona-label {
  color: #e6c28f;
  font-size: 24rpx;
}

.persona-title {
  margin-top: 14rpx;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 900;
  color: #ffe8b5;
}

.persona-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.persona-tags text {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 222, 162, 0.14);
  color: #f2d19c;
  font-size: 20rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-item {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #181512;
}

.report-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.report-score {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ef7b20;
  color: #fff;
  font-weight: 900;
}
