.reports-page {
  background: #faf8f3;
  color: #2b2621;
  padding-bottom: 120rpx;
}

.report-hero {
  position: relative;
  min-height: 500rpx;
  padding-top: 54rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.92), rgba(247, 242, 233, 0.9)),
    #faf8f3;
  border-bottom: 1rpx solid #eee9df;
}

.share {
  position: absolute;
  right: 8rpx;
  top: 20rpx;
  font-size: 24rpx;
}

.hero-title {
  font-size: 62rpx;
  line-height: 1.18;
  font-weight: 400;
  text-align: center;
  color: #28231e;
}

.hero-sub {
  margin-top: 22rpx;
  text-align: center;
  color: #9a9288;
  font-size: 24rpx;
}

.hero-avatar {
  margin: 30rpx auto 8rpx;
}

.name {
  text-align: center;
  font-size: 24rpx;
}

.persona-card {
  min-height: 290rpx;
  margin: -46rpx 4rpx 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #1a1a1a;
  border: 0;
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.12);
}

.persona-label {
  color: rgba(255, 255, 255, 0.44);
  font-size: 24rpx;
}

.persona-title {
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.9);
}

.persona-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.persona-tags text {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-item {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #181512;
}

.report-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.report-score {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f2eb;
  color: #2d2822;
  font-weight: 500;
}
