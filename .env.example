# 微信读书 API Key
WEREAD_API_KEY=wrk-xxxxxxxx

# 向量分类配置（SiliconFlow 等）
# 方式一：本地运行 BGE（推荐，免费无需 API Key）
# 先运行 npm run embed 启动本地 embedding 服务器
LLM_BASE_URL=http://localhost:3457/v1
LLM_API_KEY=local
LLM_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 方式二：使用在线 API（SiliconFlow、DeepSeek 等）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# AI 阅读报告配置（对话模型，可与向量分类使用不同平台）
# LLM_CHAT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# LLM_CHAT_API_KEY=tp-xxxxxxxx
# LLM_CHAT_MODEL=mimo-v2.5-pro
