page {
  min-height: 100%;
  background:
    linear-gradient(180deg, rgba(255, 252, 246, 0.98), rgba(246, 238, 226, 0.96)),
    #f8f1e7;
  color: #2a241d;
  font-family: "Songti SC", "STSong", "PingFang SC", "Hiragino Sans GB", serif;
  letter-spacing: 0;
}

view, text, button, input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  padding: 28rpx 30rpx 40rpx;
  background:
    linear-gradient(90deg, rgba(126, 92, 54, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(126, 92, 54, 0.025) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  margin-bottom: 30rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2b251d;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.icon-button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 253, 248, 0.9);
  color: #5d5146;
  font-size: 28rpx;
  border: 1rpx solid rgba(99, 74, 45, 0.12);
  box-shadow: 0 6rpx 18rpx rgba(92, 68, 38, 0.05);
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6f8b7a, #e8c997);
  border: 4rpx solid #fffdfa;
}

.card {
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(102, 77, 48, 0.1);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(92, 68, 38, 0.055);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #352d24;
}

.muted {
  color: #96897b;
}

.pill-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0 12rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  color: #75695e;
  background: rgba(255, 253, 248, 0.82);
  border: 1rpx solid rgba(102, 77, 48, 0.1);
  font-size: 24rpx;
}

.pill.active {
  color: #6e4424;
  background: #f5e6d1;
  font-weight: 600;
}

.primary-button {
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3d3329;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.secondary-button {
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 253, 248, 0.95);
  color: #392c1f;
  border: 1rpx solid rgba(70, 47, 23, 0.16);
  font-size: 26rpx;
  font-weight: 600;
}

.cover {
  position: relative;
  overflow: hidden;
  border-radius: 6rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.28), transparent 40%),
    linear-gradient(160deg, #fbf7ef, #dfc9a8);
  box-shadow: 8rpx 10rpx 18rpx rgba(63, 45, 24, 0.12);
}

.cover.dark {
  background: linear-gradient(160deg, #46423a, #1f201d 58%, #b9652c);
}

.cover.blue {
  background: linear-gradient(160deg, #f4f8f4, #8fa99b);
}

.cover.orange {
  background: linear-gradient(160deg, #fff8e9, #d89b5e);
}

.cover-title {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 14rpx;
  color: #18130e;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.28;
}

.cover.dark .cover-title,
.cover.blue .cover-title,
.cover.orange .cover-title {
  color: #fff;
}

.search-box {
  height: 60rpx;
  border-radius: 14rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid rgba(102, 77, 48, 0.1);
  color: #998c7d;
  font-size: 24rpx;
}
