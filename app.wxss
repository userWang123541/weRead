page {
  min-height: 100%;
  background: #fbf4ed;
  color: #080808;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

view, text, button, input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  padding: 30rpx 36rpx 128rpx;
  background: #fbf4ed;
}

.topbar {
  height: 72rpx;
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  margin-bottom: 58rpx;
}

.category-nav {
  height: 72rpx;
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  margin-bottom: 42rpx;
}

.top-title {
  text-align: center;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 400;
  color: #050505;
}

.top-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #050505;
  font-size: 48rpx;
  font-weight: 600;
}

.top-icon.right {
  justify-self: end;
}

.page-title {
  margin: 0 0 48rpx;
  font-size: 58rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #050505;
}

.card {
  background: #fffefd;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(36, 24, 12, 0.055);
}

.muted {
  color: #68645f;
}

.section-label {
  margin: 48rpx 0 22rpx;
  color: #68645f;
  font-size: 28rpx;
  font-weight: 500;
}

.big-button {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.big-button.primary {
  background: #050505;
  color: #fff;
}

.big-button.outline {
  border: 2rpx solid #777;
  color: #161616;
  background: transparent;
}

.search-pill {
  height: 76rpx;
  border-radius: 999rpx;
  border: 2rpx solid #b9bbb8;
  background: #fffefd;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 28rpx;
  color: #6d716f;
  font-size: 28rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #e9e1d8;
  color: #4e4a45;
  font-size: 24rpx;
  font-weight: 700;
}

.search-placeholder {
  color: #777c7b;
}
